<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Itmo.Dev.Platform.Common" Version="1.3.414" />
    <PackageVersion Include="Itmo.Dev.Platform.Persistence.Abstractions" Version="1.2.468" />
    <PackageVersion Include="Itmo.Dev.Platform.Persistence.Postgres" Version="1.2.484" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="15.2.0" />
    <PackageVersion Include="Refit.Reflection" Version="15.2.0" />
    <PackageVersion Include="SourceKit.Analyzers.Collections" Version="1.0.74" />
    <PackageVersion Include="SourceKit.Analyzers.Enumerable" Version="1.0.74" />
    <PackageVersion Include="SourceKit.Analyzers.MemberAccessibility" Version="1.0.74" />
    <PackageVersion Include="SourceKit.Analyzers.Nullable" Version="1.0.74" />
    <PackageVersion Include="SourceKit.Analyzers.Properties" Version="1.0.74" />
    <PackageVersion Include="Itmo.Dev.Editorconfig" Version="1.0.19" />
    <PackageVersion Include="SourceKit.Generators.Builder" Version="1.3.101" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageVersion Include="Spectre.Console.Registrars.Microsoft-Di" Version="0.6.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.0.1" />
    <PackageVersion Include="SourceKit.Generators.Builder.Annotations" Version="1.1.101" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.507" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
  </ItemGroup>
</Project>
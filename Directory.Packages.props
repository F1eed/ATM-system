<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="FluentMigrator" Version="8.0.1"/>
    <PackageVersion Include="FluentMigrator.Abstractions" Version="8.0.1"/>
    <PackageVersion Include="FluentMigrator.Runner.Core" Version="8.0.1"/>
    <PackageVersion Include="FluentMigrator.Runner.Postgres" Version="8.0.1"/>
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="11.0.0"/>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1"/>
    <PackageVersion Include="Npgsql" Version="10.0.3"/>
    <PackageVersion Include="Npgsql.DependencyInjection" Version="10.0.3"/>
    <PackageVersion Include="NSubstitute" Version="6.2.0"/>
    <PackageVersion Include="Refit.HttpClientFactory" Version="16.4.0"/>
    <PackageVersion Include="Refit.Reflection" Version="16.4.0"/>
    <PackageVersion Include="Scalar.AspNetCore" Version="2.20.0"/>
    <PackageVersion Include="Scalar.AspNetCore.Microsoft" Version="2.20.0"/>
    <PackageVersion Include="SourceKit.Analyzers.Collections" Version="1.0.74"/>
    <PackageVersion Include="SourceKit.Analyzers.Enumerable" Version="1.0.74"/>
    <PackageVersion Include="SourceKit.Analyzers.MemberAccessibility" Version="1.0.74"/>
    <PackageVersion Include="SourceKit.Analyzers.Nullable" Version="1.0.74"/>
    <PackageVersion Include="SourceKit.Analyzers.Properties" Version="1.0.74"/>
    <PackageVersion Include="Itmo.Dev.Editorconfig" Version="1.0.19"/>
    <PackageVersion Include="SourceKit.Generators.Builder" Version="1.3.101"/>
    <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2"/>
    <PackageVersion Include="Spectre.Console.Registrars.Microsoft-Di" Version="0.6.0"/>
    <PackageVersion Include="SourceKit.Generators.Builder.Annotations" Version="1.1.101"/>
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180"/>
    <PackageVersion Include="xunit" Version="2.9.3"/>
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
  </ItemGroup>
</Project>
